DATABASE_URL=sqlite:///./psx_predictor.db
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
# Set a long random value before enabling admin-only import/training operations.
ADMIN_API_TOKEN=
ENABLE_SCHEDULER=false
RETRAIN_HOUR=2
RETRAIN_MINUTE=30
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_PER_MINUTE=120
MODEL_MAX_BRIER=0.24
MODEL_MIN_TEST_SAMPLES=30
TRANSACTION_COST_RATE=0.002
MIN_AVG_TRADED_VALUE=1000000
MINIMUM_NEW_BARS_FOR_RETRAIN=36
TRAINING_WINDOW_YEARS=5
MAX_ZERO_VOLUME_RATIO=0.25

# Set a unique random secret (at least 32 characters) for signed user sessions
AUTH_SECRET=
AUTH_TOKEN_MINUTES=720
